# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored, so your endpoint URL stays out of the repo.

# Google Apps Script Web App URL that appends each finalized session as a row
# in your Google Sheet. See docs/session-capture-setup.md for the script and
# step-by-step deployment instructions.
# Leave blank to capture sessions locally only (device localStorage).
VITE_CAPTURE_ENDPOINT=
