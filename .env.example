# Copy this file to `.env` (or `.env.local`) and fill in your values.
# Both are git-ignored, so these values stay out of the repo.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and public anon key (Project Settings → API).
# The anon key is safe to expose in the client — access is controlled by
# row-level security policies (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Legacy (superseded by Supabase) ───────────────────────────────────────────
# Old Google Apps Script capture endpoint. Leave blank when using Supabase.
VITE_CAPTURE_ENDPOINT=
