# Copy to `.env.local` (git-ignored) and fill in. All values are safe to expose
# in the browser; Firestore security rules control access.

# ── Firebase (Project settings → General → Your apps → SDK setup) ────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Who may use /admin. Comma-separated. Must match the list in firestore.rules.
VITE_ADMIN_EMAILS=tom@brainiakconsulting.com

# ── Legacy: Google Apps Script capture endpoint. Leave blank. ────────────────
VITE_CAPTURE_ENDPOINT=
